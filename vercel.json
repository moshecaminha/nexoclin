{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/plataforma", "destination": "/nexoclin.html" },
    { "source": "/app", "destination": "/nexoclin.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]}
  ]
}
